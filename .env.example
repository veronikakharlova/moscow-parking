# Supabase (Settings -> API в панели Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...   # только на сервере, никогда не отправлять в браузер

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AA...
# Придумайте любую случайную строку — Telegram будет присылать её в заголовке запроса,
# так вебхук проверяет, что запрос действительно от Telegram, а не от кого-то постороннего
TELEGRAM_WEBHOOK_SECRET=придумайте-длинную-случайную-строку

# Необязательно: если бот когда-нибудь будет добавлен в несколько каналов,
# этот ID ограничит обработку только вашим каналом (узнать можно через @userinfobot
# или из первого апдейта в логах Vercel)
TELEGRAM_CHANNEL_ID=

# Публичный адрес сайта после деплоя на Vercel, нужен только для scripts/set-webhook.mjs
SITE_URL=https://your-project.vercel.app
